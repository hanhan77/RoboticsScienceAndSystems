\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cw2026-report}[2026/10/12 Compact subsystem report layout]

% Shared layout: students normally only need to edit main.tex.
\RequirePackage[T1]{fontenc}
\RequirePackage[scaled=0.95]{helvet}
\renewcommand{\familydefault}{\sfdefault}
\RequirePackage[a4paper,top=14mm,bottom=17mm,left=14mm,right=14mm,
  footskip=8mm]{geometry}
\RequirePackage{graphicx}
\RequirePackage{xcolor}
\RequirePackage{multicol}
\RequirePackage{titlesec}
\RequirePackage{caption}
\RequirePackage{fancyhdr}
\RequirePackage{amsmath}
\RequirePackage[hidelinks]{hyperref}
\urlstyle{same}

\definecolor{reportgrey}{gray}{0.35}
\definecolor{reportrule}{gray}{0.65}
\setlength{\columnsep}{7mm}
\setlength{\parindent}{0pt}
\setlength{\parskip}{4pt}
\setlength{\multicolsep}{0pt}
\setlength{\emergencystretch}{1em}
\titleformat{\section}{\normalfont\fontsize{10}{12}\selectfont\bfseries}
  {}{0pt}{\MakeUppercase}[\vspace{1pt}{\color{reportrule}\titlerule[0.3pt]}]
\titlespacing*{\section}{0pt}{9pt}{5pt}
\captionsetup{font=small,labelfont=bf,labelsep=period,
  justification=raggedright,singlelinecheck=false,hypcap=false,skip=4pt}

\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0.4pt}
\fancyfoot[L]{\footnotesize SEMTM0043/42\enspace |\enspace Individual subsystem report: Content over page 1 will not be marked.}
\fancyfoot[R]{\footnotesize\thepage}

\newcommand{\ReportHeader}{%
  {\footnotesize\bfseries Student ID: \StudentID \hfill ASSESSMENT 1, INDIVIDUAL BASIS: SUBSYSTEM TECHNICAL REPORT\par}
  \vspace{2pt}\hrule height 0.8pt\vspace{6pt}
  {\fontsize{15}{17}\selectfont\bfseries\ReportTitle\par}
  {\small\ReportSubtitle\par}
  \vspace{3pt}
  
  \vspace{4pt}{\color{reportrule}\hrule height 0.4pt}\vspace{5pt}
}

% Empty filename gives an honest placeholder with no synthetic results.
% Supplying a filename uses that image; a missing file is a compile error.
% The minipage keeps each plot and caption together without floating.
\newcommand{\ReportPlot}[4]{%
  \par\addvspace{5pt}\noindent
  \begin{minipage}{\linewidth}
    \if\relax\detokenize{#1}\relax
      {\setlength{\fboxsep}{0pt}\color{reportrule}%
      \fbox{\parbox[c][43mm][c]{\dimexpr\linewidth-2\fboxrule\relax}{%
        \centering\color{reportgrey}\small\textbf{#2}\par
        \vspace{5pt}Insert your robot measurements\par
        Label axes and units clearly\par}}}
    \else
      \centering
      \includegraphics[width=\linewidth,height=48mm,keepaspectratio]{#1}
    \fi
    \captionof{figure}{#3}\label{#4}
  \end{minipage}\par\addvspace{4pt}
}

\newcommand{\EvidenceNote}[1]{%
  \par\addvspace{7pt}
  {\footnotesize\textbf{Evidence and sources.} #1\par}
}
